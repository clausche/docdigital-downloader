{
  "manifest_version": 3,
  "name": "DocDigital - Descargar todos",
  "version": "3.1.0",
  "description": "Descarga y organiza documentos principales, anexos y trazabilidad desde las bandejas del usuario de DocDigital.",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://doc.digital.gob.cl/*",
        "https://docv3.digital.gob.cl/*"
      ],
      "js": ["docdigital-downloader.js"],
      "run_at": "document_idle"
    }
  ]
}
